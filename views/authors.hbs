<!DOCTYPE html>
<html>
<head>
  <title>Authors</title>
  <link rel="stylesheet" href="/css/index.css">
</head>
<body>
  <h1 style="text-align:center;">Authors</h1>

  <table>
    <thead>
      <tr>
        <th>Author ID</th>
        <th>Family Name</th>
        <th>Given Name</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {{#each authors}}
      <tr data-author-id="{{this.author_id}}"
          data-family-name="{{this.family_name}}"
          data-given-name="{{this.given_name}}">
        <td>{{this.author_id}}</td>
        <td>{{this.family_name}}</td>
        <td>{{this.given_name}}</td>
        <td>
          <form action="/delete-author" method="POST" style="display:inline;">
            <input type="hidden" name="author_id" value="{{this.author_id}}">
            <button type="submit">Delete</button>
          </form>
          <button class="update-author-button">Update</button>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- Update Author Modal -->
  <div id="authorUpdateModal" class="modal" style="display: none;">
    <div class="modal-content">
      <form action="/update-author" method="POST">
        <h3 style="text-align:center;">Update Author</h3>

        <input type="hidden" id="update_author_id" name="author_id">

        <div class="form-row">
          <label for="update_author_family_name">Family Name</label>
          <input type="text" id="update_author_family_name" name="family_name" required>
        </div>

        <div class="form-row">
          <label for="update_author_given_name">Given Name</label>
          <input type="text" id="update_author_given_name" name="given_name" required>
        </div>

        <div class="modal-buttons">
          <button type="submit">Save Changes</button>
          <button type="button" onclick="document.getElementById('authorUpdateModal').style.display='none'">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/index.js"></script>
</body>
</html>
