<!DOCTYPE html>
<html>
<head>
  <title>Books Genres</title>
  <link rel="stylesheet" href="/css/index.css">
</head>
<body>
  <h1 style="text-align:center;">Books Genres</h1>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Book ID</th>
        <th>Genre ID</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {{#each books_genres_intersect}}
      <tr data-id="{{this.id}}" data-book-id="{{this.book_id}}" data-genre-id="{{this.genre_id}}">
        <td>{{this.id}}</td>
        <td>{{this.book_id}}</td>
        <td>{{this.genre_id}}</td>
        <td>
          <form action="/delete-books-genres-intersect" method="POST" style="display:inline;">
            <input type="hidden" name="intersect_id" value="{{this.id}}">
            <button type="submit">Delete</button>
          </form>
          <button class="update-books-genres-button">Update</button>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- Update Modal -->
  <div id="booksGenresUpdateModal" class="modal" style="display: none;">
    <div class="modal-content">
      <form action="/update-books-genres-intersect" method="POST">
        <h3 style="text-align:center;">Update Book-Genre</h3>

        <input type="hidden" id="update_intersect_id" name="intersect_id">

        <!-- Book select -->
        <div class="form-row">
          <label for="update_book_id">Book</label>
          <select id="update_book_id" name="book_id" required>
            {{#each books}}
              <option value="{{this.book_id}}">{{this.title}}</option>
            {{/each}}
          </select>
        </div>

        <!-- Genre select -->
        <div class="form-row">
          <label for="update_genre_id">Genre</label>
          <select id="update_genre_id" name="genre_id" required>
            {{#each genres}}
              <option value="{{this.genre_id}}">{{this.genre_category}}</option>
            {{/each}}
          </select>
        </div>

        <div class="modal-buttons">
          <button type="submit">Save Changes</button>
          <button type="button" onclick="document.getElementById('booksGenresUpdateModal').style.display='none'">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/index.js"></script>
</body>
</html>
