<!DOCTYPE html>
<html>
<head>
  <title>Checked Out</title>
  <link rel="stylesheet" href="/css/index.css">
</head>
<body>
  <h1 style="text-align:center;">Checked Out</h1>

  <table>
    <thead>
      <tr>
        <th>Book ID</th>
        <th>Customer ID</th>
        <th>Days of Checkout</th>
        <th>Date of Return</th>
        <th>Extension Granted</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {{#each checkouts}}
      <tr data-book-id="{{this.book_id}}"
          data-customer-id="{{this.customer_id}}"
          data-days="{{this.days_of_checkout}}"
          data-return-date="{{this.formatted_return_date}}"
          data-extension="{{this.extension_granted}}">
        <td>{{this.book_id}}</td>
        <td>{{this.customer_id}}</td>
        <td>{{this.days_of_checkout}}</td>
        <td>{{this.formatted_return_date}}</td>
        <td>{{this.extension_granted}}</td>
        <td>
          <form action="/delete-checked-out" method="POST" style="display:inline;">
            <input type="hidden" name="customer_id" value="{{this.customer_id}}">
            <input type="hidden" name="book_id" value="{{this.book_id}}">
            <button type="submit">Delete</button>
          </form>
          <button class="update-checkedout-button">Update</button>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- Update Modal -->
  <div id="checkedOutUpdateModal" class="modal" style="display: none;">
    <div class="modal-content">
      <form action="/update-checked-out" method="POST">
        <h3 style="text-align:center;">Update Checkout</h3>

        <!-- Original PK values -->
        <input type="hidden" id="update_customer_id_original" name="update_customer_id_original">
        <input type="hidden" id="update_book_id_original" name="update_book_id_original">

        <div class="form-row">
          <label for="update_book_id">Book</label>
          <select id="update_book_id" name="update_book_id" required>
            {{#each books}}
              <option value="{{this.book_id}}">{{this.title}}</option>
            {{/each}}
          </select>
        </div>

        <div class="form-row">
          <label for="update_customer_id">Customer</label>
          <select id="update_customer_id" name="update_customer_id" required>
            {{#each customers}}
              <option value="{{this.customer_id}}">{{this.family_name}} {{this.given_name}}</option>
            {{/each}}
          </select>
        </div>

        <div class="form-row">
          <label for="update_days">Days of Checkout</label>
          <input type="number" id="update_days" name="update_days" required>
        </div>

        <div class="form-row">
          <label for="update_return_date">Date of Return</label>
          <input type="date" id="update_return_date" name="update_return_date" required>
        </div>

        <div class="form-row">
          <label for="update_extension">Extension Granted</label>
          <select id="update_extension" name="update_extension" required>
            <option value="0">No</option>
            <option value="1">Yes</option>
          </select>
        </div>

        <div class="modal-buttons">
          <button type="submit">Save Changes</button>
          <button type="button" onclick="document.getElementById('checkedOutUpdateModal').style.display='none'">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/index.js"></script>
</body>
</html>
