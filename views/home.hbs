<!DOCTYPE html>
<html>
<head>
    <title>Rural Library Management</title>
    <link rel="stylesheet" href="/css/index.css">
</head>

<body>
    <div class="dashboard">
        <h1>Welcome to the Rural Library Management App</h1>

        <div class="card-grid">
            <div class="nav-card">
                <h2>Books</h2>
                <p>View and manage book records</p>
                <a href="/books">Manage Books</a>
            </div>

            <div class="nav-card">
                <h2>Authors</h2>
                <p>Author information and associations</p>
                <a href="/authors">Manage Authors</a>
            </div>

            <div class="nav-card">
                <h2>Customers</h2>
                <p>Library customer accounts</p>
                <a href="/customers">Manage Customers</a>
            </div>

            <div class="nav-card">
                <h2>Genres</h2>
                <p>Book genre management</p>
                <a href="/genres">Manage Genres</a>
            </div>

            <div class="nav-card">
                <h2>Checked Out</h2>
                <p>Track borrowed books</p>
                <a href="/checked_out">View Records</a>
            </div>
        </div>
    </div>
    <script src="/js/reset-popup.js"></script>
</body>
</html>